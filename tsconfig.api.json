{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "api/src",
    "shared"
  ],
  "exclude": [
    "api/test"
  ]
}